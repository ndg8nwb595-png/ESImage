# 11 号部署与运维：全栈环境变量模板。
# 复制为 .env 后填写真实密钥与初始超管；.env 已被 .gitignore 忽略，禁止提交。
# 生产密钥与开发密钥分离；镜像不硬编码密钥。

# 运行环境：development / production
APP_ENV=development
TZ=Asia/Shanghai

# 应用通用密钥与 JWT 签名密钥（生产必须替换为随机长密钥）
SECRET_KEY=change-me
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
# 模型 API Key 加密密钥（32 字节，Base64）
ENCRYPTION_KEY=

# 依赖地址（容器内）
DATABASE_URL=postgresql+psycopg://esimage:esimage@postgres:5432/esimage
REDIS_URL=redis://redis:6379/0
# 容器内业务文件统一写入 MinIO 单桶
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=esimage
MINIO_SECRET_KEY=esimage123
MINIO_BUCKET=esimage

# 初始超管（首次初始化必填；用户名满足 ^[A-Za-z0-9_]{4,20}$，密码 ≥12 位且至少 3 类字符）
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=

# 豆包（火山方舟）；后台模型配置优先
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_TEXT_MODEL=doubao-seed-character-260628

# 可选/调优
JWT_ACCESS_HOURS=24
JWT_REMEMBER_DAYS=7
CORS_ORIGINS=
MAX_UPLOAD_MB=10
MAX_UPLOADS_PER_SESSION=5
GENERATION_TIMEOUT_SECONDS=120
BATCH_TIMEOUT_SECONDS=1800
WORKER_CONCURRENCY=4
EXPORT_TTL_HOURS=24
ARCHIVE_RETENTION_YEARS=5
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=90
BACKUP_RETAIN_DAYS=7
