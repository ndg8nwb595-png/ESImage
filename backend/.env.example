# 本地开发环境变量示例。复制为 .env 后修改；.env 已被 .gitignore 忽略，禁止提交。
# docker-compose 的 PostgreSQL 映射到宿主机 55433
DATABASE_URL=postgresql+psycopg://esimage:esimage@127.0.0.1:55433/esimage
# 生产环境必须替换为随机长密钥，禁止使用示例值
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
# 8 号模型配置 API Key 加密密钥：base64 编码的 32 字节
# 生成：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# 缺失或长度不符时后端启动失败；与 11 号部署模板的 ENCRYPTION_KEY 兼容（优先本变量）
MODEL_CONFIG_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# 本地文件存储根目录（最小 demo 替代 MinIO）
STORAGE_ROOT=storage
# 演示生成管线每个阶段停顿秒数
DEMO_PIPELINE_STAGE_DELAY=0.15
# 历史作品归档原件读取超时（秒）
ARCHIVE_READ_TIMEOUT_SECONDS=60
# 7 号管理后台概览四卡缓存 TTL（秒）
DASHBOARD_CACHE_TTL_SECONDS=60
# 3 号 Agent 会话交互：消息超时阈值（秒）、上下文保留轮数、SSE 心跳间隔（秒）
CHAT_MESSAGE_TIMEOUT_SECONDS=120
CHAT_CONTEXT_ROUNDS=10
SSE_HEARTBEAT_SECONDS=15
# 豆包（火山方舟）文本模型；ARK_API_KEY 为空时自动使用确定性演示桩
# 生产环境不要把真实 Key 写入仓库，只在部署环境的 .env 中配置
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TEXT_MODEL=doubao-seed-character-260628
# 4 号生图模块使用（3 号聊天不调用）：doubao-seedream-5-0-pro-260628
ARK_TIMEOUT_SECONDS=60
# 强制使用演示桩（测试环境默认开启，避免产生真实调用费用）
CHAT_USE_STUB=false
