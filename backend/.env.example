# 本地开发环境变量示例。复制为 .env 后修改；.env 已被 .gitignore 忽略，禁止提交。
# docker-compose 的 PostgreSQL 映射到宿主机 55433
DATABASE_URL=postgresql+psycopg://esimage:esimage@127.0.0.1:55433/esimage
# docker-compose 的 Redis 映射到宿主机 6379
REDIS_URL=redis://127.0.0.1:6379/0
# 生产环境必须替换为随机长密钥，禁止使用示例值
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
# 对象存储后端：local=本地目录（STORAGE_ROOT）；minio=Docker MinIO 单桶
# 本地开发默认使用 Docker MinIO，宿主端口 9002（控制台 9003）
STORAGE_BACKEND=minio
# local 后端的文件根目录；minio 后端不使用
STORAGE_ROOT=storage
# 8 号模型配置 API Key 加密密钥：base64 编码的 32 字节
# 生成：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# 缺失或长度不符时后端启动失败；与 11 号部署模板的 ENCRYPTION_KEY 兼容（优先本变量）
MODEL_CONFIG_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# MinIO 连接配置（与 docker-compose.yml 的 esimage-minio 一致）
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=esimage
MINIO_SECRET_KEY=esimage123
MINIO_BUCKET=esimage
MINIO_SECURE=false
# 演示生成管线每个阶段停顿秒数
DEMO_PIPELINE_STAGE_DELAY=0.15
# 历史作品归档原件读取超时（秒）
ARCHIVE_READ_TIMEOUT_SECONDS=60
# 7 号管理后台概览四卡缓存 TTL（秒）
DASHBOARD_CACHE_TTL_SECONDS=60
# 3 号 Agent 会话交互：消息超时阈值（秒）、上下文保留轮数、SSE 心跳间隔（秒）
CHAT_MESSAGE_TIMEOUT_SECONDS=120
CHAT_CONTEXT_ROUNDS=10
SSE_HEARTBEAT_SECONDS=15
# 豆包（火山方舟）文本模型；ARK_API_KEY 为空时聊天走确定性演示桩
# 生产环境不要把真实 Key 写入仓库，只在部署环境的 .env 中配置
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TEXT_MODEL=doubao-seed-character-260628
ARK_TIMEOUT_SECONDS=60
# 强制使用演示桩（测试环境默认开启，避免产生真实调用费用）
CHAT_USE_STUB=false

# 4 号生图任务：豆包模型接入。
# DOUBAO_* 未配置时回退到上面的 ARK_*；Key 支持 ARK_API_KEY 或 DOUBAO_API_KEY。
# DOUBAO_API_KEY=
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_TEXT_MODEL=doubao-seed-character-260628
DOUBAO_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
# 视觉理解与生成图内容审核；为空时质量审核跳过并标记「未校验」
DOUBAO_VISION_MODEL=doubao-seed-2-1-lite-260915
DOUBAO_MODERATION_MODEL=doubao-seed-2-1-lite-260915

# 整批超时秒数（默认 30 分钟）
BATCH_TIMEOUT_SECONDS=1800
# 中文字体路径；留空时自动查找系统字体
# FONT_PATH=C:/Windows/Fonts/msyh.ttc

# 测试专用：APP_ENV=test 时可用 fake 模型与故障注入，生产禁止
# APP_ENV=test
# GENERATION_MODEL_PROVIDER=fake
# GENERATION_FAULT_MODE=core
# AGENT_RETRY_BACKOFF_SCALE=0
